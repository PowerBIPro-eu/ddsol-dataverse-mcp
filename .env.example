# Dataverse MCP Server Configuration
# Copy this file to .env and fill in your actual values

# Authentication mode: "device" (device-code sign-in; the default without a client secret)
# or "client_secret" (server-to-server)
# DATAVERSE_AUTH_MODE=device

# Environment URL. Required for client_secret mode. In device mode it preselects the
# environment of every session; otherwise choose one with set_dataverse_environment.
DATAVERSE_URL=https://your-org.crm.dynamics.com

# Azure App Registration details
DATAVERSE_CLIENT_ID=your-client-id-here
# client_secret mode only
DATAVERSE_CLIENT_SECRET=your-client-secret-here
# Required for client_secret mode; optional in device mode (default: organizations)
DATAVERSE_TENANT_ID=your-tenant-id-here

# Optional: where per-folder state (the last-used environment suggestion) is kept.
# Default: %LOCALAPPDATA%\dataverse-mcp on Windows, ~/.local/state/dataverse-mcp elsewhere.
# DATAVERSE_MCP_STATE_DIR=

# Optional: Enable debug logging
# DEBUG=true
